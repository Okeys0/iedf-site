# Copy this file to .env.local and fill in real values before running the app
# against live services. The app runs and builds fine without these — forms
# log to console and content reads from lib/content/ stubs until wired up.

# Site URL — used for resolving absolute Open Graph/social image URLs.
# Update once a custom domain is confirmed (Brief, Open Question 3).
NEXT_PUBLIC_SITE_URL=https://iedf-site.vercel.app

# Sanity (CMS) — see lib/sanity/client.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Postgres (form submissions) — Neon. See README "Connecting Postgres (Neon)"
DATABASE_URL=

# Resend (notification emails when a form is submitted).
# See README "Connecting Resend" for setup.
RESEND_API_KEY=
# Where notification emails are sent. Currently ONE address receives all
# form notifications (Contact, Member Signup, Newsletter) — see the note
# in app/api/contact/route.ts for why.
ADMIN_NOTIFICATION_EMAIL=
# Optional — defaults to Resend's shared sandbox sender if unset, which
# only delivers to the email address you signed up to Resend with, until
# a domain is verified in the Resend dashboard.
RESEND_FROM_EMAIL=

# Newsletter ESP — provider TBD, Buttondown or Mailchimp
NEWSLETTER_API_KEY=

# Cloudflare Turnstile (spam protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
